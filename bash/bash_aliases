############# in3000 specific
# --- send a file over scp, create a directory and place it there
send(){
    local path="~/in3000/2026/RETTER"
    if [[ -z "$1" ]]; then
        printf "[Error] you have to send something!\n"
        return 1
    fi
    local file=$(basename "$1")
    local prefix="${file%%[[:alpha:]]*}" # isolate up to the first alpha
    local name="${file#$prefix}" # remove prefix from the left
    name="${name%%.*}" # remove everything from, and after, the first '.'

    ssh ifi "cd $path; rm -rf $name; mkdir $name"
    scp -- "$1" ifi:"$path/$name/"
}

alias mount_in3000='sshfs ifi:in3000 ~/dev/in3000                    \
        -o reconnect,ServerAliveInterval=15,ServerAliveCountMax=3    \
        -o defer_permissions -o ssh_command="ssh -o ControlMaster=no \
        -o ControlPath=none -o TCPKeepAlive=no"'
alias unmount_in3000='umount -f ~/dev/in3000'
