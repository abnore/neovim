## ------------------------------------------------------------------------------
# ~/.bash_profile
#
# Login shell initialization.
#
# This file is responsible for defining the *environment* for the user session:
#   - environment variables (LANG, PATH, EDITOR etc)
#   - compiler / build flags
#
# It is executed once for each login shell (e.g. terminal, ssh).
# Interactive behavior is delegated to ~/.bashrc, which is sourced at the end.
#
## ------------------------------------------------------------------------------

export BASH_SILENCE_DEPRECATION_WARNING=1
export EDITOR=nvim
export HOMEBREW_NO_ENV_HINTS=1
export RIPGREP_CONFIG_PATH="$HOME/.ripgreprc"

export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8

# --- Helper function to avoid duplicate PATH - equal to typeset -U in zsh
path_prepend() {
    case ":$PATH:" in
        *":$1:"*) ;;            # already present
        *) PATH="$1:$PATH" ;;
    esac
}

# --- PATH variable
path_prepend "/opt/homebrew/bin"
path_prepend "/opt/homebrew/sbin"
path_prepend "$HOME/.local/bin"
path_prepend "$HOME/.cargo/bin"
path_prepend "/opt/homebrew/opt/libtool/libexec/gnubin"
export PATH

# --- Homebrew headers and libraries (needed for autotools builds)
export CPPFLAGS="-I/opt/homebrew/include"
export LDFLAGS="-L/opt/homebrew/lib"

if [[ -f ~/.bashrc ]]; then
    source ~/.bashrc
fi
